// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model ImportBatch {
  id            Int          @id @default(autoincrement())
  fileName      String
  status        ImportStatus @default(PROCESSING)
  totalRows     Int          @default(0)
  importedRows  Int          @default(0)
  duplicateRows Int          @default(0)
  errorRows     Int          @default(0)
  errorMessage  String?
  startedAt     DateTime     @default(now())
  completedAt   DateTime?

  cycles ProductionCycle[]

  @@map("import_batches")
}

model ProductionCycle {
  id              Int      @id @default(autoincrement())
  importBatchId   Int
  sourceRowNumber Int
  createdAt       DateTime @default(now())

  machine         String   @map("MACHINE")
  orderNo         String   @map("ORDERNO")
  productCode     String   @map("PRODCODE")
  castCode        String   @map("CASTCODE")
  machineDate     DateTime @map("MACH_DATE") @db.Timestamp(3)
  cycleCounter    Int      @map("CEVRIMCOUNTER")

  moldOpenTime  Decimal @map("MENGAC") @db.Decimal(10, 3)
  injectionTime Decimal @map("ENJTIME") @db.Decimal(10, 3)
  materialTime  Decimal @map("MALTIME") @db.Decimal(10, 3)
  coolingTime   Decimal @map("SOGZAMAN") @db.Decimal(10, 3)
  moldCloseTime Decimal @map("MENGKAP") @db.Decimal(10, 3)
  cycleTime     Decimal @map("TIMERCEVRIM") @db.Decimal(10, 3)

  importBatch ImportBatch @relation(
    fields: [importBatchId],
    references: [id],
    onDelete: Restrict
  )

  @@unique([machine, machineDate, cycleCounter])
  @@unique([importBatchId, sourceRowNumber])

  @@index([machine])
  @@index([machineDate])
  @@index([orderNo])
  @@index([productCode, castCode, machine, machineDate])

  @@map("production_cycles")
}